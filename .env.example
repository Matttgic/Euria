# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# En production : secrets GitHub Actions (bot) et variables d'environnement de l'hébergeur (API).

# --- Matchs : football-data.org (clé gratuite) — https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# --- Cotes : Parlay API (clé gratuite, 1 000 crédits/mois) — https://parlay-api.com/signup
PARLAY_API_KEY=

# --- Actus blessures : The Guardian (facultative ; clé gratuite NON COMMERCIALE, 500 appels/jour)
# https://bonobo.capi.gutools.co.uk/register/developer (lien « Register developer key » de open-platform.theguardian.com/access)
GUARDIAN_API_KEY=

# --- Alertes Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Contact envoyé dans le User-Agent (exigé par MET Norway, Nominatim et Wikidata) : e-mail ou URL
EURIA_CONTACT=https://github.com/Matttgic/Euria

# --- Réglages facultatifs (valeurs par défaut indiquées)
# ODDS_BOOKMAKERS=pmu,unibet,bet365,pinnacle
# VALUE_THRESHOLD=1.10
# MIN_MATCHES_PLAYED=5
# DAYS_AHEAD=7
# STAKE_EUR=10
# EURIA_DATA_DIR=data
